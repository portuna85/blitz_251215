# Database Configuration
DB_URL=jdbc:mariadb://localhost:3306/kraft
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_DRIVER=org.mariadb.jdbc.Driver

# Database Connection Pool
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# JPA/Hibernate Configuration
JPA_DDL_AUTO=none
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect
JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis Connection Pool
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=0

# Session Configuration
SESSION_TIMEOUT=1800
REDIS_FLUSH_MODE=on_save
REDIS_SESSION_NAMESPACE=spring:session

# Server Configuration
SERVER_PORT=8080

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Naver OAuth2
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SPRING_WEB=WARN
LOG_LEVEL_SQL=WARN
LOG_LEVEL_SQL_BINDER=TRACE
LOG_FILE_NAME=logs/blitz.log
LOG_FILE_PATH=logs

# Spring Profiles
SPRING_PROFILES_INCLUDE=real-oauth

# H2 Console (개발 환경만)
H2_CONSOLE_ENABLED=false


