# ==================================
# Spring Boot Application 환경변수 템플릿
# ==================================
# 사용법:
# 1. 이 파일을 .env로 복사: cp .env.example .env
# 2. 실제 값으로 변경
# 3. .env 파일은 절대 Git에 커밋하지 않음
# ==================================

# ===== 서버 설정 =====
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=real

# ===== 데이터베이스 설정 (MariaDB) =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blitz_db
DB_USER=blitz_user
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_TIMEZONE=Asia/Seoul

# ===== Redis 설정 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE

# ===== OAuth2 - Google =====
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== OAuth2 - Naver =====
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ===== MinIO / S3 설정 =====
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=blitz-bucket

# ===== JWT 설정 (필요시) =====
JWT_SECRET=your-jwt-secret-key-min-256-bits
JWT_EXPIRATION=86400000

# ===== 로깅 설정 =====
LOG_LEVEL=INFO
LOG_PATH=/var/log/blitz

